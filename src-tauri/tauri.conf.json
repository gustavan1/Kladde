{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kladde",
  "version": "1.3.0",
  "identifier": "dk.kladde.app",
  "build": {
    "beforeDevCommand": "npm run vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Kladde",
    "shortDescription": "Noter, lektier og studieplan",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "minimumWebview2Version": "110.0.0.0",
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Danish",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "compression": "lzma"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJBRUJDQzk3REU4NUU2Q0YKUldUUDVvWGVsOHpyS3BxYlozd2dweG94Z3lpRUI3NFRualJBNUNxN2hSSXNhVjU4R1JFRUFOVGYK",
      "endpoints": [
        "https://github.com/gustavan1/Kladde/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
